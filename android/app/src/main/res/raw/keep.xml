<?xml version="1.0" encoding="utf-8"?>
<!-- audio_service looks the notification icon up by name at runtime, so the
     release resource shrinker cannot see it is used. Without this the media
     notification is rejected ("no valid small icon") and the app crashes. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_musicra" />
